  "description": "Holdline — a neutral benchmark for AI-agent write-guards: scores any guard on catch rate, false-block rate, and class-balanced agreement over a labeled corpus including an injection-attack class.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/couldbeme/holdline.git"
  },
  "homepage": "https://github.com/couldbeme/holdline#readme",
  "keywords": [
    "ai-agents",
    "guardrails",
    "benchmark",
    "agent-safety",
    "evaluation",
    "prompt-injection"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node run.mjs"
  },
  "dependencies": {
    "dsh-write-gate": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
